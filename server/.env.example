# Omixo AI API Credentials (Hard Security Rule: Never expose this to client or log it)
OMIXO_API_KEY=cpaas_your_key_here

# Omixo AI API Base URL (defaults to https://api.omixo.ai/api/v1)
OMIXO_BASE_URL=https://api.omixo.ai/api/v1

# Comma-separated list of 10-digit phone numbers allowed to receive calls (Required)
ALLOWED_NUMBERS=9876543210,9123456789

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/omixo-test

# Server Port
PORT=4000

# Mock mode for testing without incurring charges (true/false)
OMIXO_MOCK=false
